# ThingSpeak credentials — copy this file to .env and fill in your values
THINGSPEAK_CHANNEL_ID=3452779
THINGSPEAK_READ_API_KEY=MGEC1UXOPSBXRDIF
THINGSPEAK_WRITE_API_KEY=TZTS29ODSXR1TP6A

# How often simulator posts to ThingSpeak (seconds)
SIM_INTERVAL_SECONDS=60

# How often backend fetches from ThingSpeak (seconds)
FETCH_INTERVAL=60

# Leak detection: flow rate (L/min) above this for LEAK_DURATION minutes = leak
LEAK_FLOW_THRESHOLD=0.5
LEAK_DURATION_MINUTES=30

# Water tariff for billing estimate (INR per kiloliter)
WATER_TARIFF_PER_KL=50
